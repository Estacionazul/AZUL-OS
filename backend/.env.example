# Template only. Copy to .env and replace placeholders; never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
API_PORT=8080
POSTGRES_DB=azul_os_staging
POSTGRES_USER=azul_os
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:3000
RUN_MIGRATIONS=true
MIGRATIONS_CONFIRM=APPLY_AZUL_MIGRATIONS

# Only for one-time bootstrap on an EMPTY development database.
BOOTSTRAP_CONFIRM=
BOOTSTRAP_ESTABLISHMENT_NAME=
BOOTSTRAP_USERNAME=
BOOTSTRAP_CEO_NAME=
BOOTSTRAP_PIN=
BOOTSTRAP_DEVICE_NAME=
BOOTSTRAP_DEVICE_PLATFORM=windows
