# Copy this file to .env.staging. Never commit .env.staging.
# Generate unique URL-safe secrets with Node.js; do not reuse production credentials.
STAGING_POSTGRES_DB=azul_os_staging
STAGING_POSTGRES_USER=azul_staging
STAGING_DB_PASSWORD=REPLACE_WITH_RANDOM_BASE64URL_SECRET
STAGING_JWT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_BASE64URL_SECRET
STAGING_CORS_ORIGINS=http://localhost:3000

# Used only by the one-time bootstrap container in isolated staging.
BOOTSTRAP_CONFIRM=
BOOTSTRAP_ESTABLISHMENT_NAME=Estacion Azul STAGING
BOOTSTRAP_USERNAME=ceo-staging
BOOTSTRAP_CEO_NAME=CEO Staging
BOOTSTRAP_PIN=
BOOTSTRAP_DEVICE_NAME=Windows Staging
BOOTSTRAP_DEVICE_PLATFORM=windows
